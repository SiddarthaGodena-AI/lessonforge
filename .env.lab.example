# LAB settings: everything local and unlimited, for experiments (memory, reflector, prompt comparisons).
# Use:  $env:LESSONFORGE_ENV=".env.lab"      (PowerShell, before running anything)   |   Remove-Item Env:LESSONFORGE_ENV  to go back
# No cloud generator is listed ON PURPOSE: a quota fallback would silently mix models and invalidate A/B comparisons.
GENERATOR=ollama:llama3.1:8b
JUDGE=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b
GROQ_API_KEY=
PROMPT_VERSION=v2
LESSONFORGE_DB=data/memory_lab.db
# Run lab batches with --no-llm-judge so they cost no judge tokens.
