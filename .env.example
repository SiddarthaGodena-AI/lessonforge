# Copy to .env and fill in. Never commit .env. No quotes needed around values.
GROQ_API_KEY=
GEMINI_API_KEY=

# Format: provider:model[,fallback provider:model,...]   (first entry = primary; later entries are FALLBACKS and are flagged in the logs)
# Local Ollama goes LAST: it needs no key or quota but is slow and small local models write weaker lessons.
# Model names with a colon are fine:  ollama:llama3.1:8b
GENERATOR=gemini:gemini-3.8-flash,groq:openai/gpt-oss-20b,ollama:llama3.1:8b
JUDGE=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b

# Optional
PROMPT_VERSION=v2
# MIN_INTERVAL_GEMINI=8         # seconds between Gemini calls (default 5)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_CONTEXT_LENGTH=8192    # set in the environment BEFORE starting Ollama (see scripts/ollama_check.py)
